{
  "permissions": {
    "allow": [
      "Bash(git -C \"C:/Users/dicky/Documents/work/digvation/lifecycle/business/digvation-business-runtime\" log --oneline -1)",
      "Bash(git -C \"C:/Users/dicky/Documents/work/digvation/lifecycle/business/digvation-business-runtime\" status --short)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
